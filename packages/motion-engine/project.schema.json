{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "width": {
      "type": "integer",
      "minimum": 320,
      "maximum": 3840
    },
    "height": {
      "type": "integer",
      "minimum": 180,
      "maximum": 2160
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 120
    },
    "language": {
      "enum": [
        "fa",
        "en"
      ]
    },
    "background": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "elements": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "type": {
            "enum": [
              "text",
              "circle"
            ]
          },
          "content": {
            "type": "string",
            "maxLength": 1000
          },
          "x": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "y": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 3840
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 2160
          },
          "fontSize": {
            "type": "number",
            "minimum": 1,
            "maximum": 300
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        },
        "required": [
          "id",
          "type",
          "content",
          "x",
          "y",
          "width",
          "height",
          "fontSize",
          "color"
        ]
      }
    },
    "animations": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": "string"
          },
          "at": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "ease": {
            "enum": [
              "none",
              "power1.inOut",
              "power2.out"
            ]
          },
          "from": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "y": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "rotation": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "scale": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              }
            },
            "required": []
          },
          "to": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "y": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "rotation": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "scale": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              }
            },
            "required": []
          }
        },
        "required": [
          "target",
          "at",
          "duration",
          "ease",
          "from",
          "to"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "title",
    "width",
    "height",
    "fps",
    "duration",
    "language",
    "background",
    "elements",
    "animations"
  ]
}