{
  "name": "motion-automation-hub",
  "version": "1.4.0",
  "description": "Local JSON-driven motion graphics studio powered by GSAP",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node server/index.js",
    "test:browser": "node tests/browser.js && node tests/scenario-browser.js",
    "generate": "node scripts/generate.js",
    "preview:generated": "node server/index.js --project projects/generated.json",
    "auto": "npm run generate && npm run preview:generated",
    "render:code": "node scripts/render.js --source code",
    "render:reel": "node scripts/render.js --source scenario",
    "test:render": "node tests/render-integration.js",
    "render:styles": "node scripts/render-studies.js",
    "test:panel": "node tests/code-panel.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fwarmanlisa-cyber/motion-automation-hub.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/fwarmanlisa-cyber/motion-automation-hub/issues"
  },
  "homepage": "https://github.com/fwarmanlisa-cyber/motion-automation-hub#readme",
  "dependencies": {
    "ajv": "8.20.0",
    "gsap": "3.15.1",
    "playwright": "1.65.0"
  },
  "engines": {
    "node": ">=22"
  }
}
